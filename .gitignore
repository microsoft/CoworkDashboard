# Scratch / working files (not part of the skill or the Pages generator)
_temp/

# Python caches from running the bundled scripts
__pycache__/
*.pyc

# Built skill download bundles — generated and committed ONLY by CI
# (.github/workflows/sync-template.yml). Never build or commit these by hand:
# local (Windows) zip bytes differ from CI (Ubuntu) bytes and cause binary
# merge conflicts. CI force-adds them so the Pages downloads stay published.
/docs/downloads/*.zip
/Cowork Dashboard - Team Member Cowork Skill/cowork-dashboard-member.zip
/Cowork Dashboard - Team Dashboard Cowork Skill/cowork-dashboard-team-dashboard.zip

# Generated reports and outputs
output/
outputs/
*.html
!docs/index.html
!docs/demo-report.html

# Per-run and per-user artifacts that must never be committed
working/
cowork-process-registry*.json
cowork-dashboard-member-channel.*.json

# Local team/channel configuration (may contain email addresses, Teams IDs, or links)
team_config.local.json
team_channel.local.json
*.private.json
*.local.json

# Environment files, credentials, and private keys
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
