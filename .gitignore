# Scratch / working files (not part of the skill or the Pages generator)
_temp/

# Python caches from running the bundled scripts
__pycache__/
*.pyc

# Generated reports and outputs
output/
outputs/
*.html
!docs/index.html
!docs/demo-report.html

# Per-run and per-user artifacts that must never be committed
working/
cowork-process-registry*.json
cowork-dashboard-member-channel.*.json

# Local team/channel configuration (may contain email addresses, Teams IDs, or links)
team_config.local.json
team_channel.local.json
*.private.json
*.local.json

# Environment files, credentials, and private keys
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*.json
secrets*.json
